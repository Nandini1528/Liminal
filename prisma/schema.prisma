generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Prompt {
  id        String   @id @default(cuid())
  text      String
  dayOfYear Int      @unique
  createdAt DateTime @default(now())

  entries   Entry[]
}

model User {
  id            String   @id
  email         String   @unique
  createdAt     DateTime @default(now())

  timezone      String   @default("Asia/Kolkata")
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)

  entries       Entry[]
  userStickers  UserSticker[]
}

model Entry {
  id              String   @id @default(cuid())
  journalText     String   @db.Text
  aiReflection    String?  @db.Text
  savedReflection String?  @db.Text
  reflection      Json?
  createdAt       DateTime @default(now())
  entryDate       DateTime @db.Date

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  promptId        String
  prompt          Prompt   @relation(fields: [promptId], references: [id])

  stickerId       String?
  sticker         Sticker? @relation(fields: [stickerId], references: [id])

  userSticker     UserSticker?

  @@unique([userId, entryDate])
}

model Sticker {
  id           String   @id @default(cuid())
  name         String
  imagePath    String   @unique
  createdAt    DateTime @default(now())

  entries      Entry[]
  userStickers UserSticker[]
}

model UserSticker {
  id        String   @id @default(cuid())
  earnedAt  DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  stickerId String
  sticker   Sticker  @relation(fields: [stickerId], references: [id])

  entryId   String   @unique
  entry     Entry    @relation(fields: [entryId], references: [id])

  @@unique([userId, stickerId])
}